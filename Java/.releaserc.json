{
  "branches": ["main"],
  "tagFormat": "java-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i \"s/^version = '.*'/version = '${nextRelease.version}'/\" build.gradle",
      "publishCmd": "echo ${nextRelease.version} > ../java-version.txt"
    }],
    ["@semantic-release/git", {
      "assets": ["build.gradle", "CHANGELOG.md"],
      "message": "chore(release): java v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    "@semantic-release/github"
  ]
}